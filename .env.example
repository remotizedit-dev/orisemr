# ==============================================================================
# ORIS EMR - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# For local development, placeholder values are provided with explanations.

# ------------------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# In Neon Console (neon.tech):
# - Project Settings / Connection Details:
# - DATABASE_URL: Select "Pooled connection" (port usually 5432 or with -pooler in hostname)
# - DATABASE_URL_UNPOOLED: Select "Direct connection" (used for Drizzle schema migrations)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/oris_emr?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/oris_emr?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH & APPLICATION URLS
# ------------------------------------------------------------------------------
# Generate a secret via: openssl rand -base64 32 (or any 32+ character random string)
BETTER_AUTH_SECRET="your-32-char-random-secret-key-goes-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AWS S3 & CLOUDFRONT (Medical Records, Photos, Signatures)
# ------------------------------------------------------------------------------
# Optional in early local dev - the system includes defensive local file fallbacks.
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_REGION="ap-southeast-1"
S3_BUCKET_NAME="oris-emr-attachments"
NEXT_PUBLIC_CLOUDFRONT_DOMAIN="d111111abcdef8.cloudfront.net"
CLOUDFRONT_KEY_PAIR_ID="KXXXXXXXXXXXXX"
# CloudFront Private Key in PEM format (newlines escaped as \n)
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. MAILCOW / SMTP TRANSACTIONAL EMAIL
# ------------------------------------------------------------------------------
# Emails are queued in the email_queue table. If SMTP is not configured,
# emails remain safely queued and logged without breaking operations.
SMTP_HOST="mail.orisemr.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@orisemr.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@orisemr.com"
SMTP_FROM_NAME="Oris EMR"

# ------------------------------------------------------------------------------
# 5. CRON JOBS AUTHENTICATION
# ------------------------------------------------------------------------------
# Used to authenticate Vercel Cron or external triggers to /api/cron/*
CRON_SECRET="your-cron-secret-bearer-token"

# ------------------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN BOOTSTRAP ACCOUNT
# ------------------------------------------------------------------------------
# Used by `pnpm db:seed` to bootstrap the platform Super Admin account.
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="admin@orisemr.com"
SEED_SUPER_ADMIN_PASSWORD="SuperAdmin123!"
